---
export const prerender = false;
Astro.response.headers.set(
    "Cache-Control",
    "s-maxage=60, stale-while-revalidate=3600",
);
import Layout from "../../layouts/Layout.astro";
import { createSupabaseAnonClient } from "../../lib/supabase-server";
import Comments from "../../components/comments/Comments";
import { ThemeToggle } from "../../components/blog/ThemeToggle";
import ReactiveMarkdownViewer from "../../components/blog/ReactiveMarkdownViewer";
import { Button } from "@/components/ui/button";
import { ArrowLeft, Clock, Calendar } from "lucide-react";
import {
    plainTextExcerpt,
    plainTextBody,
    blogPostingJsonLd,
    SITE_ORIGIN,
} from "../../lib/seo";
import { markdownToHtml } from "../../lib/ssr-markdown";
import { isAdmin } from "../../lib/auth-utils";

const { id } = Astro.params;

if (!id) {
    return Astro.redirect("/404");
}

// Prefer locals.supabase (middleware); fall back to anon for public reads.
let post: any = null;
let topics: { id: string; name: string; color: string }[] = [];
let relatedPosts: { id: string; title: string; topic: string | null }[] = [];

const serverClient = Astro.locals.supabase;
if (serverClient) {
    try {
        const [postResult, topicsResult] = await Promise.all([
            serverClient.from("notes").select("*").eq("id", id).maybeSingle(),
            serverClient.from("topics").select("id, name, color"),
        ]);
        post = postResult.data;
        topics = topicsResult.data || [];
    } catch (err) {
        console.error("[post] locals.supabase failed", err);
    }
}

if (!post) {
    try {
        const anon = createSupabaseAnonClient();
        const [postResult, topicsResult] = await Promise.all([
            anon
                .from("notes")
                .select("*")
                .eq("id", id)
                .eq("is_public", true)
                .maybeSingle(),
            anon.from("topics").select("id, name, color"),
        ]);
        post = postResult.data;
        if (!topics.length) topics = topicsResult.data || [];
    } catch (err) {
        console.error("[post] anon client failed", err);
    }
}

// Missing (or RLS-hidden private) posts → clean 404 (never 500)
if (!post) {
    return Astro.redirect("/404");
}

const db = serverClient ?? createSupabaseAnonClient();
try {
    let relatedQuery = db
        .from("notes")
        .select("id, title, topic")
        .eq("is_public", true)
        .neq("id", post.id)
        .order("created_at", { ascending: false })
        .limit(3);
    if (post.topic) {
        relatedQuery = relatedQuery.eq("topic", post.topic);
    }
    const { data: related } = await relatedQuery;
    relatedPosts = related || [];
    // Fallback: recent public posts if topic has no siblings
    if (relatedPosts.length === 0) {
        const { data: recent } = await db
            .from("notes")
            .select("id, title, topic")
            .eq("is_public", true)
            .neq("id", post.id)
            .order("created_at", { ascending: false })
            .limit(3);
        relatedPosts = recent || [];
    }
} catch (err) {
    console.error("[post] related posts", err);
}

const viewerIsAdmin = isAdmin(Astro.locals.user?.id);

// Get topic color
let topicColor = "#007aff";
const matchingTopic = topics.find(
    (t) =>
        (post.topic_id && t.id === post.topic_id) ||
        (!post.topic_id && t.name === post.topic),
);
topicColor = matchingTopic?.color || topicColor;

const formattedDate = new Date(post.created_at).toLocaleDateString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
});

const description = plainTextExcerpt(post.content);
// Full article HTML in the initial response so scrapers/LLMs that don't run JS
// (and don't send Accept: text/markdown) still get the complete post — not just
// the ~160 char meta description.
const contentHtml = markdownToHtml(post.content);
const markdownAlternate = `/post/${post.id}.md`;
const pageUrl = `${SITE_ORIGIN}/post/${post.id}`;
const publishedTime = post.created_at
    ? new Date(post.created_at).toISOString()
    : null;
const jsonLd = blogPostingJsonLd({
    title: post.title,
    description,
    url: pageUrl,
    image: post.featured_image,
    datePublished: publishedTime,
    dateModified: publishedTime,
    articleBody: plainTextBody(post.content),
    section: post.topic,
});
---

<Layout
    title={post.title}
    description={description}
    image={post.featured_image}
    type="article"
    markdownAlternate={markdownAlternate}
    jsonLd={jsonLd}
    publishedTime={publishedTime}
    modifiedTime={publishedTime}
    section={post.topic}
    prefetchHeavyLibs={false}
>
    <!-- Focus Mode Layout -->
    <div
        class="min-h-screen bg-background text-foreground flex flex-col items-center py-12 px-6 transition-colors duration-300"
    >
        <!-- Floating Navigation -->
        <div
            class="fixed top-8 right-4 left-auto sm:right-auto sm:left-8 z-50 flex items-center gap-4"
        >
            <a href="/posts" data-astro-prefetch="hover">
                <Button
                    variant="outline"
                    className="rounded-full gap-2 pl-3 pr-5 shadow-lg bg-background/80 backdrop-blur-xl border-primary/20 hover:border-primary/50 transition-all hover:scale-105 active:scale-95 group"
                >
                    <ArrowLeft
                        className="w-5 h-5 text-primary group-hover:-translate-x-1 transition-transform"
                    />
                    <span class="font-bold tracking-tight">Back to Blog</span>
                </Button>
            </a>
        </div>

        <div class="fixed bottom-8 right-8 z-50">
            <ThemeToggle client:idle />
        </div>

        <article
            class="w-full max-w-5xl space-y-10 animate-in fade-in slide-in-from-bottom-4 duration-700"
        >
            <!-- Header Section -->
            <header class="space-y-8">
                <div class="flex items-center gap-3">
                    <span
                        class="px-4 py-1.5 rounded-full text-[0.7rem] font-black uppercase tracking-[0.2em] text-white shadow-xl shadow-primary/20"
                        style={`background-color: ${topicColor}`}
                    >
                        {post.topic}
                    </span>
                </div>

                <h1
                    class="text-5xl md:text-7xl font-black tracking-tight leading-[1.1] text-balance"
                    transition:name={`post-title-${post.id}`}
                >
                    {post.title}
                </h1>

                <div
                    class="flex flex-wrap items-center gap-8 text-sm font-bold text-muted-foreground/60 tracking-wide uppercase"
                >
                    <div class="flex items-center gap-2.5">
                        <Calendar className="h-4 w-4 text-primary" />
                        <span>{formattedDate}</span>
                    </div>
                    <div class="flex items-center gap-2.5">
                        <Clock className="h-4 w-4 text-primary" />
                        <span>{post.read_time_minutes} min read</span>
                    </div>
                </div>
            </header>

            <div
                class="h-px w-full bg-gradient-to-r from-primary/30 via-border to-transparent"
            >
            </div>

            <!--
              Cherry renders the full Cherry/markdown UI for readers.
              SSR fallback (slot) keeps real HTML in the first response for crawlers
              and for the loading gap before the island hydrates.
            -->
            <div class="w-full max-w-none min-h-[50vh]">
                <ReactiveMarkdownViewer
                    content={post.content}
                    client:only="react"
                >
                    <div
                        slot="fallback"
                        class="w-full min-h-[50vh] prose prose-slate dark:prose-invert max-w-none
                            prose-headings:font-bold prose-headings:tracking-tight
                            prose-a:text-primary prose-p:leading-relaxed prose-p:mb-6
                            prose-blockquote:border-s-[4px] prose-blockquote:border-primary/50
                            prose-blockquote:bg-muted/50 prose-blockquote:py-1 prose-blockquote:px-4
                            prose-blockquote:rounded-r-lg prose-blockquote:not-italic
                            prose-pre:bg-muted prose-pre:border prose-pre:border-border
                            prose-img:rounded-xl"
                        set:html={contentHtml}
                    />
                </ReactiveMarkdownViewer>
            </div>

            <div class="pt-20 space-y-12">
                <div
                    class="h-px w-full bg-gradient-to-r from-transparent via-border to-transparent"
                >
                </div>

                {
                    relatedPosts.length > 0 && (
                        <section class="max-w-[700px] mx-auto space-y-4">
                            <h2 class="text-2xl font-black tracking-tight">
                                More to read
                            </h2>
                            <ul class="space-y-3">
                                {relatedPosts.map((rp) => (
                                    <li>
                                        <a
                                            href={`/post/${rp.id}`}
                                            data-astro-prefetch="hover"
                                            class="group flex flex-col gap-0.5 rounded-2xl border border-border/60 bg-card/50 px-5 py-4 transition-colors hover:border-primary/40 hover:bg-card"
                                        >
                                            <span class="font-bold tracking-tight group-hover:text-primary">
                                                {rp.title}
                                            </span>
                                            {rp.topic && (
                                                <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                                                    {rp.topic}
                                                </span>
                                            )}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </section>
                    )
                }

                <section class="max-w-[700px] mx-auto">
                    <h2 class="text-3xl font-black tracking-tight mb-8">
                        Conversations
                    </h2>
                    <!-- Hydrate only when scrolled near comments (less main-thread JS) -->
                    <Comments
                        postId={post.id}
                        isAdmin={viewerIsAdmin}
                        client:visible
                    />
                </section>

                <footer
                    class="pt-20 pb-12 text-center border-t border-border/40 space-y-4"
                >
                    <p class="text-sm text-muted-foreground">
                        <a
                            href={`/post/${post.id}.md`}
                            class="underline-offset-4 hover:underline text-primary font-medium"
                            >Markdown</a
                        >
                        {" · "}
                        <a
                            href="/rss.xml"
                            class="underline-offset-4 hover:underline"
                            >RSS</a
                        >
                        {" · "}
                        <a
                            href="/llms.txt"
                            class="underline-offset-4 hover:underline"
                            >llms.txt</a
                        >
                    </p>
                    <p
                        class="text-sm font-black text-muted-foreground/30 uppercase tracking-[0.3em]"
                    >
                        © {new Date().getFullYear()} Gabriel Nava — Crafted with Passion
                    </p>
                </footer>
            </div>
        </article>
    </div>
</Layout>
