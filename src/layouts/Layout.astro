---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import {
	SITE_NAME,
	DEFAULT_DESCRIPTION,
	getOgImageUrl,
	absoluteUrl,
} from "../lib/seo";

interface Props {
	title: string;
	description?: string;
	image?: string | null;
	type?: "website" | "article";
	/** Override canonical URL; defaults to the current page URL on the canonical host. */
	canonicalUrl?: string;
	/** Optional absolute or site-relative URL for text/markdown alternate (agents). */
	markdownAlternate?: string | null;
}

const {
	title,
	description = DEFAULT_DESCRIPTION,
	image = null,
	type = "website",
	canonicalUrl,
	markdownAlternate = null,
} = Astro.props;

// Prefer configured site origin so crawlers always see www + https,
// even if the request hit a preview/worker host.
const siteOrigin =
	Astro.site?.origin ?? "https://www.gabrielnava.dev";
const pageUrl = canonicalUrl
	? absoluteUrl(canonicalUrl, siteOrigin)
	: new URL(Astro.url.pathname + Astro.url.search, siteOrigin).href;
const ogImage = getOgImageUrl(image);
const metaDescription = (description || DEFAULT_DESCRIPTION)
	.replace(/\s+/g, " ")
	.trim();
const markdownAlternateUrl = markdownAlternate
	? absoluteUrl(markdownAlternate, siteOrigin)
	: type === "article"
		? `${pageUrl.replace(/\/$/, "")}.md`
		: null;

// Origin of the Supabase project, used to warm up the connection before the
// client fires its first data/auth request.
let supabaseOrigin: string | null = null;
try {
	supabaseOrigin = new URL(import.meta.env.PUBLIC_SUPABASE_URL).origin;
} catch {
	supabaseOrigin = null;
}
---

<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<ClientRouter />
		<script is:inline>
			const setTheme = () => {
				try {
					const savedTheme = localStorage.getItem("blog-theme");
					const theme = savedTheme || "light";
					document.documentElement.setAttribute("data-theme", theme);
					if (theme === "dark") {
						document.documentElement.classList.add("dark");
					} else {
						document.documentElement.classList.remove("dark");
					}
				} catch (e) {
					document.documentElement.setAttribute(
						"data-theme",
						"light",
					);
					document.documentElement.classList.remove("dark");
				}
			};
			setTheme();
			document.addEventListener("astro:after-swap", setTheme);
		</script>

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="canonical" href={pageUrl} />
		{
			markdownAlternateUrl && (
				<link
					rel="alternate"
					type="text/markdown"
					href={markdownAlternateUrl}
					title="Markdown version"
				/>
			)
		}

		<!-- Warm up connections to the data + image-proxy origins -->
		{
			supabaseOrigin && (
				<link rel="preconnect" href={supabaseOrigin} crossorigin />
			)
		}
		<link rel="preconnect" href="https://wsrv.nl" crossorigin />

		<!-- Preload heavy preview assets -->
		<link rel="prefetch" href="/libs/echarts.min.js" as="script" />
		<link
			rel="prefetch"
			href="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js"
			as="script"
		/>

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={metaDescription} />

		<!-- Open Graph / LinkedIn / Facebook -->
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:secure_url" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:alt" content={title} />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={ogImage} />
	</head>
	<body class="bg-background text-foreground enable-custom-scroll">
		<slot />
	</body>
</html>
